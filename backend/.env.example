# --- Supabase ---
# Project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=https://mwvbhbzcjvxxzrpaxiaz.supabase.co
# Public anon key for the frontend Supabase client.
# This key is safe to expose, but service_role is not.
SUPABASE_ANON_KEY=
# Service role key (secret, NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL connection string for DB scripts, not for the /ask API.
# Use the Supabase Shared Pooler connection string here on IPv4 networks.
DATABASE_URL=postgresql://postgres.mwvbhbzcjvxxzrpaxiaz:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=700

# --- Embedding (dimension must match rag_chunks.embedding) ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EXPECTED_DIMENSIONS=384

# --- Retrieval ---
# Final number of chunks sent to GPT. Increase when answers often lack evidence;
# decrease when prompts contain too much noise or API cost/latency is high.
RAG_TOP_K=10
# Number of first-stage retrieval candidates before reranking.
RAG_FIRST_STAGE_K=30
# Minimum similarity applied inside each Supabase RPC before client-side merging.
# Lower it when too few chunks are returned; raise it when unrelated chunks appear.
RAG_MIN_SIMILARITY=0.30
# Hybrid retrieval weight for source priority.
# final_score = similarity * (1 - RAG_PRIORITY_WEIGHT) + priority_score * RAG_PRIORITY_WEIGHT
RAG_PRIORITY_WEIGHT=0.30
# Dataset priority weight. Dataset order is rule > main(notice/student_life) > ce.
RAG_DATASET_PRIORITY_WEIGHT=0.15
# Source-kind weight. Gives webpage body chunks a small advantage over attachments
# when their semantic scores are close.
RAG_SOURCE_KIND_WEIGHT=0.10
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_DEVICE=cpu
RERANKER_WEIGHT=0.80
# Comma-separated list of Supabase RPC functions to fan out across, in priority order.
# Each RPC must accept (query_embedding, match_count, min_similarity, metadata_filter)
# and return rows with a `similarity` field. The backend keeps one high-scoring,
# non-duplicate row from each successful RPC first, then fills the remaining
# slots by global similarity until RAG_TOP_K.
RPC_NAMES=match_rule_documents,match_pknu_notice_documents,match_pknu_student_life_documents,match_rag_documents
# Max characters per chunk included in the GPT prompt. Increase when useful
# details such as dates, contacts, places, or conditions are being truncated.
MAX_CHARS_PER_CHUNK=500
# Max characters shown for each answer-focused source excerpt in the UI.
SOURCE_EXCERPT_MAX_CHARS=320

# --- Server ---
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
PORT=8000
