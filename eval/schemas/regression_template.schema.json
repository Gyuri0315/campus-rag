{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus RAG regression label template",
  "type": "object",
  "required": ["id", "question", "category", "case_type", "answerable", "expected_source", "required_facts", "forbidden_claims", "expected_no_info", "tags", "scenario_tags", "difficulty", "label_status", "origin", "expected_behavior", "review_notes"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9_]+$" },
    "question": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "case_type": { "type": "string", "minLength": 1 },
    "answerable": { "type": ["boolean", "null"] },
    "expected_source": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["dataset", "title_keywords", "allowed_urls", "source_ids"],
          "properties": {
            "dataset": { "$ref": "#/$defs/stringList" },
            "title_keywords": { "$ref": "#/$defs/stringList" },
            "allowed_urls": { "$ref": "#/$defs/stringList" },
            "source_ids": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        }
      ]
    },
    "required_facts": { "type": "array" },
    "forbidden_claims": { "$ref": "#/$defs/stringList" },
    "expected_no_info": { "type": ["boolean", "null"] },
    "tags": { "$ref": "#/$defs/stringList" },
    "scenario_tags": { "$ref": "#/$defs/stringList" },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "label_status": { "enum": ["needs_review", "source_verified", "label_verified", "ready"] },
    "origin": { "enum": ["existing", "new"] },
    "expected_behavior": { "type": "string" },
    "review_notes": { "type": "string" }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
