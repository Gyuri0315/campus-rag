{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus RAG draft evaluation question",
  "type": "object",
  "required": ["id", "question", "case_type", "scenario_tags", "difficulty", "label_status", "origin"],
  "properties": {
    "id": { "type": "string", "pattern": "^draft_[a-z0-9_]+$" },
    "question": { "type": "string", "minLength": 1 },
    "case_type": {
      "enum": ["규정·이수 조건", "신청 기간·일정", "신청 방법·절차", "연락처·위치", "학생생활 정보", "특정 공지·첨부파일", "학과·학년도 구분", "부분 답변 가능", "데이터에 없는 질문"]
    },
    "scenario_tags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "label_status": { "const": "needs_review" },
    "origin": { "enum": ["existing", "new"] }
  },
  "additionalProperties": false
}
